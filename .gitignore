# --- Secrets (NEVER commit) ---
deploy/secrets/*.keytab
deploy/secrets/krb5.conf
deploy/**/ssl_db/
**/*.keytab
.claude/settings.local.json
.claude/*.lock

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
dist/
build/

# --- Debian packaging build artifacts ---
# dpkg-buildpackage writes the .deb, .changes, .buildinfo, .dsc and the source tarball one
# level ABOVE this tree; these are what debhelper leaves inside it (`make deb` cleans them).
debian/.debhelper/
debian/files
debian/*.substvars
debian/debhelper-build-stamp
debian/linuxmuster-squid/
*.deb
*.buildinfo
*.changes

# --- crabbox test state/captures ---
.crabbox/

# --- Editor / OS ---
.idea/
.vscode/
*.swp
.DS_Store
