#
# The throwaway build venv of packaging/build-venv.sh, installed from
# packaging/requirements-build.lock; nothing of it is shipped.
# Build backend of controlplane/ (its [build-system] requires): the lmnsquid wheel is built
# without build isolation, so no unpinned setuptools is fetched.
setuptools>=68
# uv for the lock gate: build-venv.sh runs `lock-deps.sh --check` with it before anything goes
# into the shipped venv, and the fast tier (ci.yml) installs the same uv from this lock.
uv
