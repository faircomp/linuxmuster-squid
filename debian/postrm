#!/bin/sh
# SPDX-FileCopyrightText: Kevin Stenzel
# SPDX-License-Identifier: GPL-3.0-or-later
set -e
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
fi
# The admin's enable/disable decision survives a remove (the unit stays masked until the
# postinst of a reinstall unmasks it) and is forgotten on purge. deb-systemd-helper comes
# with init-system-helpers, which is Essential.
if [ "$1" = remove ]; then
    deb-systemd-helper mask linuxmuster-squid.service >/dev/null || true
fi
# Deliberately do NOT delete config/state + venv on remove (only on purge).
if [ "$1" = "purge" ]; then
    deb-systemd-helper purge linuxmuster-squid.service >/dev/null || true
    deb-systemd-helper unmask linuxmuster-squid.service >/dev/null || true
    rm -rf /opt/linuxmuster-squid
    rm -rf /etc/linuxmuster-squid /var/lib/linuxmuster-squid
    # The safe.directory entry the postinst added for the instances repo.
    if command -v git >/dev/null 2>&1; then
        git config --system --unset-all safe.directory \
            '^/var/lib/linuxmuster-squid/instances$' 2>/dev/null || true
    fi
fi
#DEBHELPER#
exit 0
