#!/bin/sh
# SPDX-FileCopyrightText: Kevin Stenzel
# SPDX-License-Identifier: GPL-3.0-or-later
set -e

# System user (in the docker group for socket access)
if ! getent passwd lmnsquid >/dev/null 2>&1; then
    adduser --system --group --no-create-home \
        --home /var/lib/linuxmuster-squid lmnsquid
fi
if getent group docker >/dev/null 2>&1; then
    usermod -aG docker lmnsquid || true
fi

mkdir -p /etc/linuxmuster-squid/secrets /etc/linuxmuster-squid/blocklists \
         /var/lib/linuxmuster-squid/instances

# Config with a random API token (only if it does not exist yet)
CFG=/etc/linuxmuster-squid/config.yml
if [ ! -f "$CFG" ]; then
    TOKEN="$(openssl rand -hex 32)"
    # umask 077 -> file is created with 0600 (no 0644 window for the API token).
    ( umask 077
      cat > "$CFG" <<EOF
api_token: "$TOKEN"
instances_dir: /var/lib/linuxmuster-squid/instances
secrets_dir: /etc/linuxmuster-squid/secrets
blocklists_dir: /etc/linuxmuster-squid/blocklists
bind_host: 127.0.0.1
bind_port: 8080
api_url: http://127.0.0.1:8080
EOF
    )
    chmod 600 "$CFG"
fi

INST_DIR=/var/lib/linuxmuster-squid/instances
# The updater's rollback notes are not part of the change log.
[ -f "$INST_DIR/.gitignore" ] || printf '*.prev\n' > "$INST_DIR/.gitignore"

# Ownership BEFORE any git command, on every configure. 7.3.1-7.3.3 committed as root and
# chowned afterwards: git 2.47 and later start their auto-maintenance after a commit as a
# DETACHED process that creates and removes objects/maintenance.lock while `chown -R`
# walks the tree, and the vanished file failed the configure under `set -e` (intermittent;
# caught by the 7.3.3 release gate). Running first, the chown also repairs root-owned
# files those versions left in the repository, before git touches it as lmnsquid below.
chown -R lmnsquid:lmnsquid /etc/linuxmuster-squid /var/lib/linuxmuster-squid
chmod 700 /etc/linuxmuster-squid/secrets

# Git change log of the instance definitions (docs/operations.md). Every git command runs
# AS lmnsquid, the owner of the repository and the user the service commits as, so git
# never writes a root-owned file into it and never sees a foreign-owned repository
# ("dubious ownership", why the 7.3.0 store never committed). safe.directory is only for
# root: an admin running `git log` on the lmnsquid-owned repository.
# Background maintenance is off in the repository config, set before its first commit:
# no git process outlives the package configure, and the service's own commits (same
# repository config) spawn none either. A change log of a few commits needs no gc.
# The change log is best effort, but never silently: a git step that fails does not fail the
# configure; it prints one WARNING line on stderr (where apt shows it) naming the step and the
# repository (git's own message stays visible above it, but for the staged-changes probe), and
# the configure goes on; the service below is handled as without it.
if command -v git >/dev/null 2>&1; then
    git_warn() {  # <exit code> <step>
        echo "WARNING: linuxmuster-squid: change log step '$2' failed (exit $1) in $INST_DIR;" \
             "the configure goes on without it" >&2
    }
    if ! git config --system --get-all safe.directory 2>/dev/null | grep -qx "$INST_DIR"; then
        git_rc=0
        git config --system --add safe.directory "$INST_DIR" || git_rc=$?
        [ "$git_rc" = 0 ] || git_warn "$git_rc" "git config --system --add safe.directory"
    fi
    # runuser resets HOME, not XDG_CONFIG_HOME: an admin environment pointing it into /root
    # would make every call warn "unable to access '/root/.config/git/...'".
    as_lmnsquid() { runuser -u lmnsquid -- env -u XDG_CONFIG_HOME git -C "$INST_DIR" "$@"; }
    git_step() {  # <git arguments>: as lmnsquid in the repository, a WARNING if it fails
        git_rc=0
        as_lmnsquid "$@" || git_rc=$?
        [ "$git_rc" = 0 ] || git_warn "$git_rc" "git $*"
    }
    if [ ! -d "$INST_DIR/.git" ]; then
        git_step init -q
    fi
    git_step config user.name  "linuxmuster-squid"
    git_step config user.email "lmnsquid@localhost"
    git_step config maintenance.auto false
    git_step config gc.auto 0
    git_step add -- .gitignore
    # 7.3.0 left instance files staged but never committed: record what is there now. Only when
    # git lists a definition, tracked or new: `git add` fails on a pathspec that matches nothing
    # (a fresh install). A repository git cannot read lists none; the steps around warn.
    yaml="$(as_lmnsquid ls-files --cached --others --exclude-standard -- '*.yaml' 2>/dev/null ||
            true)"
    if [ -n "$yaml" ]; then
        git_step add -A -- '*.yaml'
    fi
    # exit 1: something is staged; anything above 1 is an error of git (its own words stay
    # out: outside a readable repository it answers with its whole usage text)
    git_rc=0
    as_lmnsquid diff --cached --quiet 2>/dev/null || git_rc=$?
    case "$git_rc" in
        0) ;;
        1) git_step commit -q -m "lmnsquid: package configure (record existing definitions)" ;;
        *) git_warn "$git_rc" "git diff --cached --quiet" ;;
    esac
fi

# Harden the shipped tree on EVERY configure, not only on upgrade: 1.3.0 shipped
# /opt/linuxmuster-squid world-writable (0777 directories, 0666 files). dpkg resets the
# mode of every file it replaces but leaves EXISTING directories untouched, so a server
# upgraded from 1.3.0 keeps world-writable directories -- among them
# venv/lib/python3.12/site-packages, where a dropped .pth file runs as lmnsquid, and
# lmnsquid is in the docker group. Only the write bits are cleared (`go-w`, never a
# blanket 0755), so anything intentionally restrictive stays as restrictive as it was.
chmod -R go-w /opt/linuxmuster-squid

# The service by Debian's rules, as dh_installsystemd's snippets do it, by hand because the
# unit stays in /lib/systemd/system (moving it to /usr/lib within one package risks losing it
# under usrmerge). deb-systemd-helper keeps the admin's decision: a new installation enables
# the service, afterwards it stays as the admin left it, so `systemctl disable` survives
# upgrades (up to 7.3.6 every configure enabled it again). The preinst recorded the state of a
# server coming from 7.3.6 or older. Without a running systemd (image build, chroot) only the
# links are made and the service starts with the next boot.
UNIT=linuxmuster-squid.service
deb-systemd-helper unmask "$UNIT" >/dev/null || true
if deb-systemd-helper --quiet was-enabled "$UNIT"; then
    deb-systemd-helper enable "$UNIT" >/dev/null || true
else
    deb-systemd-helper update-state "$UNIT" >/dev/null || true
fi

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    # Enabled: restart on an upgrade (loads the new code, starts a stopped service), start on
    # a new installation. Disabled or masked: only try-restart, so a service that still runs
    # gets the new code and a stopped one stays stopped (restart would do the same for a
    # disabled unit but print "not starting it", and it fails on a masked unit that runs).
    # deb-systemd-invoke honours policy-rc.d.
    if [ "$(systemctl is-enabled "$UNIT" 2>/dev/null)" = enabled ]; then
        if [ -n "${2:-}" ]; then
            deb-systemd-invoke restart "$UNIT" || true
        else
            deb-systemd-invoke start "$UNIT" || true
        fi
    else
        deb-systemd-invoke try-restart "$UNIT" || true
    fi
    # On upgrade, lift all instances onto this package's pinned default image (best-effort;
    # each instance updates with its own health-check auto-rollback), but only through a
    # service that runs after this configure; a service the admin keeps off is not started
    # for it. Wait briefly for the restarted API; never fail the install.
    if [ -n "${2:-}" ] && ! systemctl is-active --quiet "$UNIT"; then
        echo "linuxmuster-squid: the service is $(systemctl is-enabled "$UNIT" 2>/dev/null)" \
             "and not running, instances not updated; run 'lmnsquid update-all' after starting it"
    elif [ -n "${2:-}" ]; then
        LMN=/opt/linuxmuster-squid/venv/bin/lmnsquid
        i=0
        while [ "$i" -lt 30 ]; do
            "$LMN" health >/dev/null 2>&1 && break
            i=$((i + 1)); sleep 1
        done
        # Best-effort (the apt transaction never fails over these), but never silent:
        # the CLI output goes to the journal, and a non-zero exit (an instance rolled
        # back, not brought up, or the API unreachable) is printed where apt shows it.
        lmn_step() {
            if out=$("$LMN" "$@" 2>&1); then
                printf '%s\n' "$out" | logger -t linuxmuster-squid -p daemon.info || true
            else
                printf '%s\n' "$out" | logger -t linuxmuster-squid -p daemon.warning || true
                echo "WARNING: linuxmuster-squid: 'lmnsquid $*' reported failures:" >&2
                # The CLI names the affected instances on stderr and carries the reason
                # per instance; show those lines here so they reach the apt output, the
                # full result stays in the journal.
                printf '%s\n' "$out" | grep -E 'instance\(s\) failed|"error": ' \
                    | head -n 5 | sed 's/^/  /' >&2
                echo "  Full output: journalctl -t linuxmuster-squid; state: lmnsquid list" >&2
            fi
        }
        lmn_step update-all
        # Containers created before 7.3.1 run without the blocklist mount. reconcile
        # replaces exactly the containers whose definition no longer matches what they
        # were created from (label lmnsquid.spec) -- so one update-all just recreated is
        # left alone, an old one is replaced once (new container first, the old one
        # comes back if the new one is not healthy).
        if dpkg --compare-versions "$2" lt 7.3.1; then
            lmn_step reconcile
        fi
    fi
fi

#DEBHELPER#
exit 0
